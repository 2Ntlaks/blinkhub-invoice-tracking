# Copy to .env only if you need to override defaults. Everything works without it.

# Database: SQLite file by default (zero setup). Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./blinkhub.db
# Example PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://blinkhub:blinkhub@localhost:5432/blinkhub

# Load the case-study seed data on startup when the database is empty.
SEED_ON_STARTUP=true

# Frontend origin(s) allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Used by docker-compose.yml for the PostgreSQL container.
POSTGRES_USER=blinkhub
POSTGRES_PASSWORD=blinkhub
POSTGRES_DB=blinkhub
